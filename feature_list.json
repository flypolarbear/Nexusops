{
  "project": "NexusOps",
  "description": "AI Native Operations Platform - 支持 Vibe Coding 和 Agent Market 的运维平台",
  "mvp_scope": "快速开发 + 快速迭代 + 快速上线 + 开放式 Agent 扩展",
  "target_users": ["研发", "算法工程师", "业务开发", "Agent 开发者"],
  "vibe_coding_workflow": {
    "quick_validate": "创建版本 → 自动部署测试 → 获取测试 URL → 验证功能",
    "quick_iterate": "发现问题 → 快速回滚/重新部署 → 迭代修复",
    "quick_release": "验证通过 → 申请上线 → Admin 审批 → 一键上线"
  },
  "agent_market_vision": {
    "concept": "开放式 Agent 市场，支持第三方开发者创建和接入自定义 AI Agent",
    "json_output_guarantee": ["JSON Schema + Few-shot", "Function Calling", "Outlines/Guidance 状态机", "Instructor 库", "JSON-Repair + 重传"],
    "multi_language_sdk": ["Python", "Node.js", "Go", "Java"],
    "integration_points": ["统一 JSON 接口规范", "Agent Gateway", "Agent Registry", "结构化输出渲染"]
  },
  "phases": [
    {
      "name": "Phase 1: Vibe Coding 基础（MVP）",
      "description": "支持完整的快速验证和快速上线流程",
      "status": "completed",
      "features": [
        {
          "id": "VC-001",
          "category": "vibe_coding",
          "priority": "critical",
          "description": "Projects 页面 - 版本卡片增强",
          "details": [
            "显示测试 URL（可复制、可打开）",
            "显示部署区域列表",
            "显示 Git 分支和 Commit 信息",
            "显示 ArgoCD 应用链接",
            "快速操作按钮：重新部署、申请上线"
          ],
          "passes": true
        },
        {
          "id": "VC-002",
          "category": "vibe_coding",
          "priority": "critical",
          "description": "创建版本流程优化",
          "details": [
            "输入 Codename + Git 分支",
            "自动生成测试环境 URL",
            "触发 CI/CD 构建和部署",
            "显示部署进度",
            "部署完成后通知"
          ],
          "passes": true
        },
        {
          "id": "VC-003",
          "category": "vibe_coding",
          "priority": "critical",
          "description": "申请上线流程",
          "details": [
            "一键发起生产上线申请",
            "填写上线说明和测试结果",
            "自动关联 Git commit 和镜像版本",
            "Admin 审批通过后自动触发部署",
            "多区域依次/同时部署"
          ],
          "passes": true
        },
        {
          "id": "VC-004",
          "category": "vibe_coding",
          "priority": "high",
          "description": "Dashboard - 测试版本概览",
          "details": [
            "显示所有测试版本及其健康状态",
            "显示每个版本部署的区域",
            "快速跳转到版本详情",
            "一键申请上线"
          ],
          "passes": true
        },
        {
          "id": "VC-005",
          "category": "vibe_coding",
          "priority": "high",
          "description": "WorldMap - 按版本筛选",
          "details": [
            "版本选择器筛选显示",
            "悬浮显示版本详情（Git、测试 URL）",
            "点击跳转版本详情页"
          ],
          "passes": true
        }
      ]
    },
    {
      "name": "Phase 2: 部署监控与诊断",
      "description": "提升问题定位和解决效率",
      "status": "completed",
      "features": [
        {
          "id": "OPS-001",
          "category": "operations",
          "priority": "high",
          "description": "Deployments - 部署链追踪增强",
          "details": [
            "显示完整的 CI/CD → ArgoCD → Health Check 链路",
            "每一步状态实时更新",
            "失败步骤高亮并显示原因",
            "一键操作：强制同步、快速回滚"
          ],
          "passes": true
        },
        {
          "id": "OPS-002",
          "category": "operations",
          "priority": "high",
          "description": "Resources - K8sGPT 诊断增强",
          "details": [
            "自动诊断资源问题",
            "提供修复建议",
            "一键应用修复",
            "诊断结果与版本关联"
          ],
          "passes": true,
          "agent_ready": "可改造为 nexusops.k8sgpt Agent"
        },
        {
          "id": "OPS-003",
          "category": "operations",
          "priority": "medium",
          "description": "AI Assistant - 快捷命令",
          "details": [
            "/deploy <version> to <region>",
            "/rollback <version> in <region>",
            "/status <version>",
            "/logs <service> --tail 100",
            "/compare <v1> vs <v2>"
          ],
          "passes": true,
          "agent_ready": "可改造为 nexusops.chat Agent"
        }
      ]
    },
