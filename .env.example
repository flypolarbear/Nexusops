# NexusOps Environment Variables

# Required: Anthropic API key for OpenClaw agents
ANTHROPIC_API_KEY=sk-ant-...

# OpenClaw config injected at runtime (generated from openclaw/openclaw.json)
# Run: export OPENCLAW_CONFIG_CONTENT=$(cat openclaw/openclaw.json)
OPENCLAW_CONFIG_CONTENT=

# Optional overrides
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_TIMEOUT=60
OPENCLAW_AUTH_TOKEN=nexusops-gateway-token-change-me
