{
  "session_name": "claude-work",
  "created_at": "2026-02-25",
  "description": "EXO Team tmux 分屏与角色对应关系",
  "layout": {
    "description": "4 分屏布局",
    "ascii": [
      "┌────────────────────────────────────────────────────────────────────┐",
      "│                        GLM (Coordinator)                            │",
      "│  任务分派 | 冲突解决 | 质量门禁 | 最终汇总                           │",
      "├─────────────────────┬─────────────────────┬────────────────────────┤",
      "│        Elon         │        Ryan         │       Cynthia          │",
      "│   PM/Architect      │   Full-Stack Dev    │   QA/Testing           │",
      "│                     │                     │                        │",
      "│  [PRD 进度]         │  [实现进度]         │  [测试进度]            │",
      "│  [架构状态]         │  [代码质量]         │  [E2E 状态]            │",
      "│  [里程碑]           │  [技术债务]         │  [质量门禁]            │",
      "└─────────────────────┴─────────────────────┴────────────────────────┘"
    ]
  },
  "panes": {
    "0": {
      "role": "GLM",
      "identity": "Executive Lead / Coordinator",
      "responsibilities": [
        "总控协调",
        "跨角色冲突解决",
        "质量门禁",
        "最终汇总"
      ],
      "output_files": [
        "research.md",
        "agentic_pact/state/task_list.json"
      ],
      "tmux_target": "claude-work:0.0"
    },
    "1": {
      "role": "Ryan",
      "identity": "Full-Stack Developer",
      "responsibilities": [
        "实现方案",
        "代码质量",
        "接口契约",
        "安全权限"
      ],
      "current_task": "SPRINT-001: AI 配置界面与对话功能修复",
      "output_files": [
        "exo_research/ryan_findings.md"
      ],
      "tmux_target": "claude-work:0.1"
    },
    "2": {
      "role": "Cynthia",
      "identity": "QA Engineer",
      "responsibilities": [
        "测试用例",
        "自动化测试",
        "调试诊断",
        "质量门禁"
      ],
      "current_task": "SPRINT-005: 测试服务保持与回归测试",
      "notes": "不要关闭测试服务 (PostgreSQL/Redis/Backend)",
      "output_files": [
        "exo_research/cynthia_findings.md",
        "test_results/"
      ],
      "tmux_target": "claude-work:0.2"
    },
    "3": {
      "role": "Elon",
      "identity": "PM + Architect",
      "responsibilities": [
        "需求澄清",
        "PRD/Spec",
        "架构方向",
        "里程碑规划"
      ],
      "current_task": "SPRINT-004: Sprint 统筹与进度跟踪",
      "output_files": [
        "exo_research/elon_findings.md",
        "docs/"
      ],
      "tmux_target": "claude-work:0.3"
    }
  },
  "common_tmux_commands": {
    "list_panes": "tmux list-panes -t claude-work -F \"#{pane_index}: #{pane_title}\"",
    "send_to_pane": "tmux send-keys -t claude-work:0.{pane_index} \"command\" C-m",
    "capture_pane": "tmux capture-pane -t claude-work:0.{pane_index} -p",
    "select_pane": "tmux select-pane -t claude-work:0.{pane_index}"
  },
  "workflow": {
    "task_dispatch": [
      "1. GLM 分析用户需求 → 拆分并行任务包",
      "2. GLM 通过 tmux send-keys 分派任务给各分屏",
      "3. 各 Agent 独立执行任务",
      "4. GLM 监控进度 (tmux capture-pane)"
    ],
    "progress_report": [
      "1. Agent 完成子任务后发送完成信号",
      "2. GLM 收集各 Agent 输出",
      "3. GLM 解决冲突 (如有)",
      "4. GLM 更新汇总文档"
    ],
    "completion": [
      "1. GLM 确认所有任务完成",
      "2. GLM 截图保存证据",
      "3. GLM 提交代码",
      "4. GLM 向用户汇报"
    ]
  },
  "sprint_tasks": [
    {
      "id": "SPRINT-001",
      "title": "AI 配置界面与对话功能修复",
      "owner": "Ryan",
      "status": "pending"
    },
    {
      "id": "SPRINT-002",
      "title": "集成连接状态显示优化",
      "owner": "Ryan",
      "status": "pending"
    },
    {
      "id": "SPRINT-003",
      "title": "前端构建与类型检查",
      "owner": "Ryan",
      "status": "pending"
    },
    {
      "id": "SPRINT-004",
      "title": "Sprint 统筹与进度跟踪",
      "owner": "Elon",
      "status": "in_progress"
    },
    {
      "id": "SPRINT-005",
      "title": "测试服务保持与回归测试",
      "owner": "Cynthia",
      "status": "in_progress"
    }
  ]
}
