[run]
source = app
branch = True
omit =
    app/__init__.py
    app/core/__init__.py
    app/models/__init__.py
    app/api/__init__.py
    app/services/__init__.py
    app/stores/__init__.py
    app/gateway/__init__.py
    app/gateway/executor/__init__.py
    app/agents/__init__.py
    */tests/*
    */__pycache__/*
    */site-packages/*

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

[html]
directory = htmlcov
title = NexusOps Coverage Report

[xml]
output = coverage.xml

[json]
output = coverage.json
show_contexts = True
